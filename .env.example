# WindSight Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Elexon BMRS API Base URL (Default official endpoint)
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Local Data Cache Directory
CACHE_DIR=./data/cache
CACHE_ENABLED=true

# Decision Cutoff Rule Default (DA_1200: Day-Ahead 12:00 UTC)
DEFAULT_CUTOFF_RULE=DA_1200

# Frontend API Target (Leave empty if using relative proxy /api, or set for external backend)
VITE_API_BASE_URL=

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
